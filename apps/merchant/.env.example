# The Sotechy API (local: `pnpm dev:local` at the repo root)
API_URL=http://localhost:4000

# Google sign-in: the Web OAuth client ID from Google Cloud Console → APIs & Services → Credentials.
# Add http://localhost:3002 (and the live dashboard address) as Authorised JavaScript origins, and list the
# same ID in the API's GOOGLE_CLIENT_IDS. Left empty, local dev signs in a test account instead.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
