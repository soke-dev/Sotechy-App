# Which backend the app uses: the live API (https://api.sotechy.shop) unless EXPO_PUBLIC_API_URL is set.
# Restart Expo (pnpm dev:mobile) after changing it: a reload alone doesn't pick up .env changes.

# 1) Live API: leave EXPO_PUBLIC_API_URL out, or
# EXPO_PUBLIC_API_URL=https://api.sotechy.shop

# 2) Local API on your computer (`pnpm dev:local`). Use the Wi-Fi address it prints, e.g.
#    http://192.168.1.250:4000 (Android emulator: http://10.0.2.2:4000)
EXPO_PUBLIC_API_URL=http://192.168.1.250:4000

# Google sign-in (OAuth client IDs from Google Cloud Console → APIs & Services → Credentials).
# iOS also needs the reversed iOS client ID added as a URL scheme in app.json (see README).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
