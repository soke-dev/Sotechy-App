# Which backend the app uses. Keep one EXPO_PUBLIC_API_URL line active, then restart Expo
# (pnpm dev:mobile): a reload alone doesn't pick up .env changes.
EXPO_PUBLIC_USE_MOCK=false

# 1) Live API on Railway
# EXPO_PUBLIC_API_URL=https://api-production-a623.up.railway.app

# 2) Local API on your computer (`pnpm dev:local`). Use the Wi-Fi address it prints, e.g.
#    http://192.168.1.250:4000 (Android emulator: http://10.0.2.2:4000)
EXPO_PUBLIC_API_URL=http://192.168.1.250:4000

# 3) Demo mode with built-in data, no backend: comment out the URLs and set EXPO_PUBLIC_USE_MOCK=true

# Google sign-in (OAuth client IDs from Google Cloud Console → APIs & Services → Credentials).
# iOS also needs the reversed iOS client ID added as a URL scheme in app.json (see README).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
