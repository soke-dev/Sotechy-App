# Leave EXPO_PUBLIC_API_URL empty (or set EXPO_PUBLIC_USE_MOCK=true) to run the app in
# demo mode with built-in dummy data — no backend needed.
EXPO_PUBLIC_USE_MOCK=true

# Sotechy API base URL (apps/api), used when demo mode is off
#  - Web / iOS simulator:  http://localhost:4000
#  - Android emulator:     http://10.0.2.2:4000
#  - Physical phone:       http://<your-computer-LAN-IP>:4000
#  - Production:           your Railway API URL, e.g. https://api.sotechy.shop
EXPO_PUBLIC_API_URL=
