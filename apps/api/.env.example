# Railway injects DATABASE_URL automatically when you add a Postgres service
# and reference it: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sotechy

# Long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000

# Comma-separated origins allowed to call the API from a browser (admin, landing page, Expo web).
# The phone apps don't need to be listed.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# This API's public address. On Railway it's worked out from RAILWAY_PUBLIC_DOMAIN, so you can leave it empty there.
PUBLIC_API_URL=

# The customer app's URL scheme (app.json "scheme"), used to send customers back to the app after paying
APP_SCHEME=sotechy

# The seed runs on every deploy and only adds what's missing.
# It creates this admin account the first time:
SEED_ADMIN_EMAIL=admin@sotechy.shop
SEED_ADMIN_PASSWORD=change-me
# true = also add a few [DEMO] products to try the app with (turn off once real products are in)
SEED_DEMO_PRODUCTS=false

# --- Money Moves (https://docs.usemoneymoves.xyz) ---
# Customers pay on Money Moves' page by bank transfer, crypto or the Money Moves app.
# API key from Money Moves → Developers → API keys. sk_test_… for testing, sk_live_… for real money.
MONEYMOVES_SECRET_KEY=
# Signing secret from Money Moves → Developers → Webhooks (starts with whsec_; test and live differ).
# Webhook endpoint to add there: https://<your-api>/payments/webhooks/moneymoves
MONEYMOVES_WEBHOOK_SECRET=
# Only change for a different Money Moves environment
MONEYMOVES_API_URL=https://business.usemoneymoves.xyz/api/v1

# --- Google sign-in ---
# The OAuth client IDs your apps use (iOS, Android and web), comma-separated
GOOGLE_CLIENT_IDS=

# --- Email (https://resend.com) ---
# API key from Resend → API Keys (starts with re_). Empty = emails are printed to the console instead.
RESEND_API_KEY=
# Sender; its domain (sotechy.shop) must be verified in Resend → Domains
EMAIL_FROM=Sotechy <hello@sotechy.shop>
