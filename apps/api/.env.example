# Railway injects DATABASE_URL automatically when you add a Postgres service
# and reference it: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sotechy

# Long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000

# Comma-separated origins allowed to call the API (landing page, admin, Expo web)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# Used by `pnpm db:seed` to create the first admin account
SEED_ADMIN_EMAIL=admin@sotechy.shop
SEED_ADMIN_PASSWORD=change-me

# --- Integrations that still need credentials ---
# Paystack (card/bank online payments). Leave empty to keep the "card" method disabled.
PAYSTACK_SECRET_KEY=
# Where Paystack sends the customer after paying (Expo web URL or app deep link)
PAYSTACK_CALLBACK_URL=
